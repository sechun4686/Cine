function normalize_(s) {
  return String(s || '').replace(/\s+/g, ' ').trim();
}

function findTargets_() {
  const form = FormApp.getActiveForm();
  const headers = form.getItems(FormApp.ItemType.SECTION_HEADER)
    .concat(form.getItems(FormApp.ItemType.PAGE_BREAK));
  return ITEMS.map(function (it) {
    const q = normalize_(it.query);
    const matches = headers.filter(function (h) { return normalize_(h.getTitle()).indexOf(q) !== -1; });
    return { item: it, matches: matches };
  });
}

function previewChanges() {
  let ok = true;
  findTargets_().forEach(function (t) {
    if (t.matches.length !== 1) {
      ok = false;
      Logger.log('⚠️ 문항 ' + t.item.no + ' "' + t.item.query + '": 일치하는 항목 ' + t.matches.length + '개 (1개여야 함)');
    } else {
      const firstLine = t.item.description.split('\n')[0];
      Logger.log('✅ 문항 ' + t.item.no + ' → "' + t.matches[0].getTitle() + '" | ' + firstLine);
    }
  });
  Logger.log(ok ? '모두 1개씩 찾았습니다. applyChanges 를 실행하세요.'
                : '찾지 못한 문항이 있습니다. 폼의 해당 항목 제목에 요청 문장이 그대로 들어 있는지 확인하세요.');
}

function applyChanges() {
  const targets = findTargets_();
  const bad = targets.filter(function (t) { return t.matches.length !== 1; });
  if (bad.length) {
    throw new Error('일치하지 않는 문항이 있어 아무것도 바꾸지 않았습니다. previewChanges 로그를 확인하세요.');
  }
  targets.forEach(function (t) {
    const h = t.matches[0];
    if (h.getType() === FormApp.ItemType.SECTION_HEADER) {
      h.asSectionHeaderItem().setHelpText(t.item.description);
    } else {
      h.asPageBreakItem().setHelpText(t.item.description);
    }
  });
  Logger.log('문항 ' + targets.length + '개의 설명을 바꿨습니다.');
}
